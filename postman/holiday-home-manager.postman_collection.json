{
  "info": {
    "name": "Holiday Home Manager",
    "description": "Collection completa per testare tutte le funzionalita' del backend Holiday Home Manager (gestione appartamenti, ospiti, prenotazioni, check-in/check-out e chiavi digitali). Esegui prima 'Register' e 'Login' nella cartella Auth: il token viene salvato automaticamente nella variabile {{token}} e riusato da tutte le altre richieste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "apartmentId",
      "value": ""
    },
    {
      "key": "guestId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "extraServiceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Registrazione e login dello staff. Da eseguire per prima cosa.",
      "item": [
        {
          "name": "Register staff (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea il primo utente staff. Ripetibile con email diverse per creare altri utenti.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Mario\",\n  \"lastName\": \"Rossi\",\n  \"email\": \"mario.rossi@holidayhome.it\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\",\n  \"phone\": \"+39 333 1234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set('userId', pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Effettua il login e salva automaticamente il token JWT nella variabile {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mario.rossi@holidayhome.it\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ]
        }
      ]
    },
